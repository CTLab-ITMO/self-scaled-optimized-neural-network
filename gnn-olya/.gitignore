# Окружение. 1.3 ГБ, и оно непереносимо: в .venv/bin/* зашиты абсолютные пути
# этой машины. Пересоздаётся одной командой ./setup_env.sh
.venv/
venv/
__pycache__/
*.pyc

# Данные MNIST: 23 МБ, скачиваются заново через src/prepare_data.py
artifacts/mnist.npz
artifacts/mnist_raw/

# Служебное состояние прогонов: нужно только на своей машине, чтобы
# возобновлять прерванный расчёт. В репозитории смысла не имеет.
results/.series/
results/.series_smoke/
results/.refine/
results/.run_all.lock

# Черновики и временное
*.bak
*.bak[0-9]
*.orig
*~
results/smoke.csv
results/dev_*.csv

# ЧТО НАМЕРЕННО НЕ ИГНОРИРУЕТСЯ
#
# results/*.csv, *.txt, *.html, *.pdf - это результаты экспериментов, ради
# которых всё и делалось. Они мелкие (1.4 МБ на всё) и должны ехать вместе с
# кодом: без них таблицы в отчётах нечем подтвердить.
#
# artifacts/*.npy, artifacts/graph_stats_*.csv, artifacts/confusion/ - тоже
# результаты, а не данные: перестановка pi (иначе прогоны неповторимы),
# дескрипторы графов и матрицы ошибок. Вместе меньше мегабайта.
